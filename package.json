{
  "name": "music-rank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace @music-rank/api\" \"npm run dev --workspace @music-rank/web\"",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace @music-rank/database",
    "db:seed": "npm run seed --workspace @music-rank/database",
    "db:generate": "npm run generate --workspace @music-rank/database",
    "typecheck": "npm run build --workspace @music-rank/contracts && npm run build --workspace @music-rank/database && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace @music-rank/contracts && npm run build --workspace @music-rank/database && npm run build --workspace @music-rank/api && npm run build --workspace @music-rank/web",
    "start": "npm run start --workspace @music-rank/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "vitest": "^4.0.8"
  }
}
